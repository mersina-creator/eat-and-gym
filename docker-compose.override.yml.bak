# Unraid: данные не в docker.img, а в appdata — так их видит бэкап и они переживают пересоздание контейнеров.
# Postgres — на кэш-пуле напрямую (/mnt/cache), минуя FUSE-слой /mnt/user: так быстрее и без сюрпризов с fsync.
services:
  db:
    volumes:
      - /mnt/cache/appdata/eat_and_gym/pg:/var/lib/postgresql/data
  backend:
    volumes:
      - /mnt/user/appdata/eat_and_gym/geo:/geo
  minio:
    volumes:
      - /mnt/user/appdata/eat_and_gym/minio:/data
